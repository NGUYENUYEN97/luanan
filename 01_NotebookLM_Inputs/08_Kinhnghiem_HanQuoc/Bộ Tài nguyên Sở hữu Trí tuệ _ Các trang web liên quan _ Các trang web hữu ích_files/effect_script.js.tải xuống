// 검색결과 화면 검색바 div 샐랙트 펼치기 ///////////////////////////////////////////////////////////////////////////////////////////////////////////
function searchSelectOpen(option, selected) {
	var selectDisplay = document.getElementById(option).style.display;

	if(selectDisplay == "none"){
		document.getElementById(option).style.display = "";
		document.getElementById(selected).className = "st";
	} else {
		searchSelectClose(option, selected);
	}
}

// div 샐랙트 닫기
function searchSelectClose(option, selected) {
	document.getElementById(option).style.display = "none";
	document.getElementById(selected).className = selected;
}

// 검색 div 클릭
function cell_location(str, str2) {
	document.getElementById('sc_select').style.display = "none";
	document.getElementById('textSearch').className = "";
	document.getElementById('in_cell').innerHTML = str2;
}


// 사이트내 검색 결과 탭
function resultTab(st1) {
	var st1;
	var tabNumber = "TAB" + st1;
	resultTabClear();
	document.getElementById(tabNumber).className = "on";
	if (document.getElementById("TAB0").className != "on") {
		resultTabTextAll();
	} else {
		for (var count=1; count<5; count++) {
			document.getElementById("RESULT" + count).style.display = 'inline';
		}
	}
}

function resultTabClear() {
	for (var count=0; count<4; count++) {
		if(document.getElementById("TAB"+count).className == "on") {
			document.getElementById("TAB"+count).className = 'off';
		}
	}
}

function resultTabTextAll() {
	for (var count=1; count<5; count++) {
		if (document.getElementById("TAB"+count).className != "on") {
			document.getElementById("RESULT" + count).style.display = 'none';
		} else {
			document.getElementById("RESULT" + count).style.display = 'inline';
		}
	}
}
