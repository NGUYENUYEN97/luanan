function tabNews(tnewsNumber) {
	//alert(abc);
	var tnewsNumber;
	var tnewsTextNumber;
	var tnewsImgNumber;

	tabNewsClear();
	tnewsTextNumber = "TAB_NEWS" + tnewsNumber;
	tnewsImgNumber = "NWT" + tnewsNumber;
//	document.getElementById(tnewsTextNumber).style.display = 'inline';
		document.getElementById(tnewsImgNumber).src = "/wcom/en/img/m_n_tab_" + tnewsNumber + "_on.png";
		document.getElementById(tnewsTextNumber).style.display = 'inline';
}
function tabNewsClear() {
	for (var count=1; count<4; count++) {
		document.getElementById("TAB_NEWS" + count).style.display = 'none';
		document.getElementById("NWT" + count).src = '/wcom/en/img/m_n_tab_' + count + '_off.png';
	}
}
