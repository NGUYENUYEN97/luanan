function jsGoSearch(isFormSubmit,searchSelect) {
  if(searchSelect == '1'){
	  var searchForm = document.getElementById("searchForm");
      var queryText = searchForm.queryText.value;
      if (queryText == "") {
          var msg = "";
          msg += "===============================\r";
          msg += "   Enter the keyword to search for!   \r";
          msg += "===============================\r";
          alert(msg);
          searchForm.queryText.focus();
          if( isFormSubmit ) return false;
      }else{
          searchForm.queryText.value = RemoveBad(queryText);
          if( isFormSubmit ){
             return true;
          } else{
             searchForm.submit();
          }
      }
  }else if(searchSelect == '2'){
	  var kiprisForm = document.getElementById("kiprisForm");
      var Query = kiprisForm.Query.value;
      if (Query == "") {
        var msg = "";
        msg += "===============================\r";
        msg += "   Enter the keyword to search for!   \r";
        msg += "===============================\r";
        alert(msg);
        kiprisForm.Query.focus();
        if( isFormSubmit ) return false;
      }else{
        kiprisForm.Query.value = RemoveBad(Query);
        if( isFormSubmit ) {
          return true;
        } else {
          kiprisOpenWindow();
          kiprisForm.target = "kiprisSearch";
          kiprisForm.submit();
        }
      }
  }
}

