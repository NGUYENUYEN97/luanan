      window.open(Url, WinName, centerOptions);
}

function RemoveBad(InStr){
 InStr = InStr.replace(/\</g,"");
 InStr = InStr.replace(/\>/g,"");
 InStr = InStr.replace(/\"/g,"");
 InStr = InStr.replace(/\'/g,"");
 InStr = InStr.replace(/\*/g,"");
 InStr = InStr.replace(/\?/g,"");

 return InStr;
}

