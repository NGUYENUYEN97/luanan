function GotoPage(form, docStart){
	form.docStart.value = docStart * form.docPage.value + 1;
	form.checkKey.value ="N";
	form.submit();
	return;
}

function hasRadio(input) {
    var rtn = 0;
    if (input.length > 1) {
        for (var inx = 0; inx < input.length; inx++) {
            if (input[inx].checked) return rtn = inx;
        }
    } else {
        if (input.checked) return rtn;
    }
    return rtn;
}

function OpenPage(u){
    	var iMyWidth = 920;
