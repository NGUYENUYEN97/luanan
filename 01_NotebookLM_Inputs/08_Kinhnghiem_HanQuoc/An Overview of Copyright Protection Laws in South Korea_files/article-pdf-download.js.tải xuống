        lineHeight = 18;
        spacingAfter = 10;
      } else if (block.type === 'list-item') {
        indent = 16;
        lineHeight = 18;
        spacingAfter = 5;
      } else if (block.type === 'table-row') {
        size = 11;
        color = [0.12, 0.12, 0.12];
        lineHeight = 16;
        spacingAfter = 6;
      }

      const lines = wrapSegments(block.segments || [], layout.contentWidth - indent, size, style);
      lines.forEach(function (lineSegments) {
        ensureSpace(lineHeight);
        drawSegmentsLine(lineSegments, layout.marginLeft + indent, layout.y, size, style, color);
        layout.y += lineHeight;
      });
      layout.y += spacingAfter;
    });

    return pdf.finalize();
  }

  function downloadBlob(blob, fileName) {
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = fileName || 'article.pdf';
    document.body.appendChild(link);
    link.click();
    link.remove();
    setTimeout(function () {
      URL.revokeObjectURL(url);
    }, 1500);
  }

  async function generatePdf(config, button) {
    const overlay = createOverlay(config);
    if (overlay) {
      overlay.hidden = false;
      setOverlayMessage(overlay, config.strings.preparing);
    }

    const root = getArticleRoot(config, button);
    const doc = buildDocumentDefinition(config, root);

    if (overlay) {
      setOverlayMessage(overlay, config.strings.formatting);
    }

    const blob = renderDocumentToPdf(doc, config);

    if (overlay) {
      setOverlayMessage(overlay, config.strings.downloading);
    }

    downloadBlob(blob, config.fileName);

    if (overlay) {
      setTimeout(function () {
        overlay.hidden = true;
      }, 900);
    }

    return blob;
  }

  function init(config) {
    if (typeof document === 'undefined') return;
    const buttons = document.querySelectorAll('.apd-download-pdf-button');
    if (!buttons.length) return;

    buttons.forEach(function (button) {
      button.addEventListener('click', async function () {
        if (button.disabled) return;
        button.disabled = true;
        try {
          await generatePdf(config, button);
        } catch (error) {
          console.error(error);
          const overlay = createOverlay(config);
          if (overlay) {
            overlay.hidden = false;
            setOverlayMessage(overlay, config.strings.error);
            setTimeout(function () {
              overlay.hidden = true;
            }, 1800);
          }
        } finally {
          setTimeout(function () {
            button.disabled = false;
          }, 800);
        }
      });
    });
  }

  return {
    SimplePDF: SimplePDF,
    buildDocumentDefinition: buildDocumentDefinition,
    renderDocumentToPdf: renderDocumentToPdf,
    generatePdf: generatePdf,
    init: init,
    normalizeText: normalizeText
  };
}));

if (typeof window !== 'undefined' && typeof window.APDFactory !== 'undefined') {
  document.addEventListener('DOMContentLoaded', function () {
    const config = window.APDConfig || {};
    window.APDFactory.init(config);
  });
}
